page {
  min-height: 100%;
  background: #f7f5f0;
  color: #252824;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 38rpx 48rpx;
}

.surface {
  background: rgba(255, 255, 252, 0.92);
  border: 1rpx solid #e4ded3;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(55, 48, 37, 0.06);
}

.muted {
  color: #8a8d86;
}

.section-title {
  margin: 34rpx 4rpx 18rpx;
  color: #686d66;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.empty-panel {
  padding: 96rpx 28rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  margin: 0 auto 28rpx;
  border: 3rpx solid #3c765d;
  border-radius: 24rpx;
  color: #3c765d;
  font-size: 54rpx;
  transform: rotate(-3deg);
}

.empty-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 12rpx;
  color: #9a9b96;
  font-size: 25rpx;
}
