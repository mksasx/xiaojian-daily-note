.panel-page {
  padding: 18px 20px calc(87px + env(safe-area-inset-bottom));
}

.data-actions {
  display: flex;
  flex-wrap: wrap;
  margin: -4.5px;
}

.data-action {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: calc(50% - 9px);
  min-height: 57px;
  margin: 4.5px;
  padding: 9px 10px;
  background: #fffefa;
  border: 1px solid #e6e2d8;
  border-radius: 12px;
  text-align: left;
}

.data-action.wide {
  width: calc(100% - 9px);
  min-height: 49px;
}

.action-icon {
  flex: 0 0 23px;
  width: 23px;
  height: 23px;
  margin-right: 9px;
}

.action-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.action-title,
.action-subtitle {
  display: block;
}

.action-title {
  color: #2d302d;
  font-size: 11px;
  font-weight: 600;
}

.action-subtitle {
  margin-top: 2px;
  color: #898b84;
  font-size: 9px;
  line-height: 1.4;
}

.data-note {
  display: flex;
  margin-top: 16px;
  padding: 13px;
  background: #edece6;
  border-radius: 13px;
}

.data-note.is-syncing {
  background: #f2e7dc;
}

.note-icon {
  flex: 0 0 25px;
  width: 25px;
  height: 25px;
  margin-right: 11px;
}

.note-copy {
  flex: 1;
  min-width: 0;
}

.note-title-row {
  display: flex;
  align-items: center;
}

.note-title {
  font-size: 12px;
  font-weight: 700;
}

.note-text {
  display: block;
  margin-top: 3px;
  color: #898b84;
  font-size: 10px;
  line-height: 1.55;
}

.sync-dot {
  width: 7px;
  height: 7px;
  margin-left: 7px;
  background: #d59668;
  border-radius: 50%;
}

.sync-dot.synced {
  background: #3c765d;
}

.sync-dot.error {
  background: #b45d4c;
}

.sync-dot.muted {
  background: #999c96;
}

.sync-dot.syncing {
  animation: sync-pulse 1.4s ease-in-out infinite;
}

.danger-action {
  margin-top: 16px;
}

.danger-action .action-title {
  color: #aa5749;
}

.version {
  margin-top: 24px;
  color: #b1afa7;
  font-size: 10px;
  text-align: center;
}

@keyframes sync-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
