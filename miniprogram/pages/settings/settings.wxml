<view class="page-shell settings-page">
  <view class="settings-header">
    <view class="eyebrow">本地优先 · 微信同步</view>
    <view class="page-title">设置</view>
    <view class="page-copy">待办优先保存在本机；开启云同步后，同一微信账号可以在不同设备继续使用。</view>
  </view>

  <view class="status-card surface">
    <view class="status-number">{{taskCount}}</view>
    <view class="status-label">条待办</view>
    <view class="status-divider"></view>
    <view class="status-number">{{dayCount}}</view>
    <view class="status-label">个日期</view>
  </view>

  <view class="section-title">备份与多设备</view>
  <view class="settings-group surface">
    <button class="setting-row" bindtap="onExportBackup">
      <view>
        <view class="row-title">导出备份</view>
        <view class="row-copy">生成与桌面版、网页版兼容的 JSON</view>
      </view>
      <text class="row-arrow">›</text>
    </button>
    <view class="row-divider"></view>
    <button class="setting-row" bindtap="onImportFile">
      <view>
        <view class="row-title">从微信文件导入</view>
        <view class="row-copy">选择聊天中保存的 JSON 并安全合并</view>
      </view>
      <text class="row-arrow">›</text>
    </button>
    <view class="row-divider"></view>
    <button class="setting-row" bindtap="onImportClipboard">
      <view>
        <view class="row-title">从剪贴板导入</view>
        <view class="row-copy">适合无法直接选择文件的设备</view>
      </view>
      <text class="row-arrow">›</text>
    </button>
  </view>

  <view class="section-title">微信云同步</view>
  <view class="settings-group surface">
    <view class="setting-row">
      <view>
        <view class="row-title">按微信用户同步</view>
        <view class="row-copy">不读取微信号、昵称或手机号，只使用当前小程序的用户标识隔离数据。</view>
      </view>
      <switch checked="{{cloudSyncEnabled}}" color="#3c765d" bindchange="onCloudSyncChange" />
    </view>
    <view wx:if="{{cloudSyncEnabled}}" class="row-divider"></view>
    <button wx:if="{{cloudSyncEnabled}}" class="setting-row" disabled="{{isSyncing}}" bindtap="onSyncNow">
      <view>
        <view class="row-title">立即同步</view>
        <view class="row-copy">合并本机和云端记录，不会覆盖较新的修改。</view>
      </view>
      <text class="row-arrow">›</text>
    </button>
  </view>

  <view class="sync-card surface">
    <view class="sync-dot {{syncTone}}"></view>
    <view>
      <view class="row-title">{{syncTitle}}</view>
      <view class="row-copy">{{syncCopy}}</view>
    </view>
  </view>

  <view class="section-title">数据管理</view>
  <view class="settings-group surface">
    <button class="setting-row danger" bindtap="onClearData">
      <view>
        <view class="row-title">{{clearDataTitle}}</view>
        <view class="row-copy">{{clearDataCopy}}</view>
      </view>
      <text class="row-arrow">›</text>
    </button>
  </view>

  <view class="version">小笺微信小程序 · v{{appVersion}}</view>
</view>
