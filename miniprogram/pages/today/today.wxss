.today-page {
  padding-top: 16rpx;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.weekday {
  color: #3c765d;
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 0.15em;
}

.date-title-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.date-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 650;
  letter-spacing: -0.04em;
}

.date-arrow {
  margin-left: 12rpx;
  color: #777b75;
  font-size: 32rpx;
}

.progress-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 94rpx;
  box-sizing: border-box;
  width: 94rpx;
  height: 94rpx;
  border: 6rpx solid #e5e3db;
  border-radius: 999rpx;
}

.progress-value {
  color: #3c765d;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-copy {
  margin-top: 2rpx;
  color: #a1a39e;
  font-size: 18rpx;
}

.day-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 22rpx 0 20rpx;
}

.day-arrow,
.today-chip {
  margin: 0 14rpx;
  padding: 0;
  background: transparent;
  color: #7b7f79;
  line-height: 58rpx;
}

.day-arrow {
  flex: 0 0 54rpx;
  width: 58rpx;
  height: 54rpx;
  font-size: 42rpx;
  line-height: 54rpx;
}

.today-chip {
  flex: 0 0 112rpx;
  min-width: 116rpx;
  height: 54rpx;
  border: 2rpx solid #b9d5c8;
  border-radius: 999rpx;
  color: #3c765d;
  font-size: 23rpx;
  line-height: 50rpx;
}

.task-form {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
}

.add-mark {
  color: #3c765d;
  flex: none;
  font-size: 36rpx;
}

.task-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin-left: 10rpx;
  font-size: 27rpx;
}

.input-placeholder {
  color: #a9aaa5;
}

.add-button {
  flex: none;
  margin: 0;
  padding: 0 16rpx;
  background: #3c765d;
  border-radius: 999rpx;
  color: #fff;
  font-size: 23rpx;
  line-height: 50rpx;
}

.carry-banner {
  width: 100%;
  margin: 16rpx 0 0;
  padding: 17rpx 20rpx;
  background: #edf5f0;
  border: 1rpx solid #c8ddd2;
  border-radius: 20rpx;
  color: #3c765d;
  font-size: 23rpx;
  line-height: 1.45;
}

.task-list {
  margin-top: 18rpx;
}

.task-item {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid rgba(219, 215, 204, 0.76);
  border-radius: 0;
  box-shadow: none;
}

.task-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  box-sizing: border-box;
  width: 40rpx;
  min-width: 40rpx;
  max-width: 40rpx;
  height: 40rpx;
  min-height: 40rpx;
  max-height: 40rpx;
  margin: 0 18rpx 0 0;
  padding: 0;
  background: #fff;
  border: 3rpx solid #98a69f;
  border-radius: 11rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
}

.task-check.is-checked {
  background: #3c765d;
  border-color: #3c765d;
}

.task-text {
  flex: 1;
  min-width: 0;
  padding: 20rpx 0;
  font-size: 27rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.task-delete {
  flex: 0 0 52rpx;
  box-sizing: border-box;
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #aaa59c;
  font-size: 34rpx;
  line-height: 50rpx;
}

.is-done {
  opacity: 0.68;
}

.is-done .task-text {
  text-decoration: line-through;
}

.completed-block {
  margin-top: 16rpx;
}

.completed-heading {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 20rpx 8rpx;
  background: transparent;
  color: #777b75;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: left;
}

.completed-list {
  margin-top: 4rpx;
}

.dialog-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(29, 31, 29, 0.38);
}

.edit-dialog {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx;
  max-width: 420px;
}

.dialog-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.edit-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  background: #f4f2ec;
  border: 2rpx solid #ddd7cc;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.dialog-button {
  min-width: 130rpx;
  margin: 0 0 0 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 68rpx;
}

.dialog-button.secondary {
  background: #efede7;
  color: #626660;
}

.dialog-button.primary {
  background: #3c765d;
  color: #fff;
}

@media (max-width: 350px) {
  .date-title {
    font-size: 54rpx;
  }

  .progress-ring {
    flex-basis: 88rpx;
    width: 88rpx;
    height: 88rpx;
  }

  .day-nav {
    margin-top: 18rpx;
  }
}

@media (max-height: 700px) {
  .today-page {
    padding-top: 8rpx;
  }

  .day-nav {
    margin: 12rpx 0;
  }

  .empty-panel {
    padding-top: 48rpx;
  }
}
