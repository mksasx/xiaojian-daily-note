.history-page {
  padding-top: 42rpx;
}

.history-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.eyebrow {
  color: #3c765d;
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 0.15em;
}

.page-title {
  margin-top: 10rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 64rpx;
  font-weight: 700;
}

.summary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-bottom: 8rpx;
  color: #8d908a;
  font-size: 23rpx;
  line-height: 1.6;
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin-top: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #3c765d;
  font-size: 38rpx;
}

.search-input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #a9aaa5;
}

.history-list {
  margin-top: 28rpx;
}

.history-group {
  overflow: hidden;
  margin-bottom: 22rpx;
}

.history-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 26rpx 28rpx 22rpx;
  background: transparent;
  text-align: left;
  line-height: 1.4;
}

.history-date-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 31rpx;
  font-weight: 700;
}

.history-progress {
  margin-top: 6rpx;
  color: #8c8f89;
  font-size: 22rpx;
}

.history-arrow {
  color: #92958f;
  font-size: 42rpx;
}

.history-tasks {
  padding: 0 28rpx 24rpx;
}

.history-task {
  display: flex;
  align-items: flex-start;
  padding: 11rpx 0;
  color: #4d514c;
  font-size: 27rpx;
  line-height: 1.45;
}

.history-task.is-done {
  color: #999b96;
  text-decoration: line-through;
}

.history-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin: 14rpx 16rpx 0 0;
  border: 2rpx solid #86968e;
  border-radius: 50%;
}

.history-dot.is-complete {
  background: #3c765d;
  border-color: #3c765d;
}

.history-empty {
  margin-top: 80rpx;
}
