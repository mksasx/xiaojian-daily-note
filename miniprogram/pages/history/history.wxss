.history-page {
  padding-top: 16rpx;
}

.history-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.eyebrow {
  color: #3c765d;
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 0.15em;
}

.page-title {
  margin-top: 10rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 650;
}

.summary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-bottom: 8rpx;
  color: #8d908a;
  font-size: 23rpx;
  line-height: 1.6;
}

.search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #3c765d;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 27rpx;
}

.search-placeholder {
  color: #a9aaa5;
}

.history-list {
  margin-top: 20rpx;
}

.history-group {
  overflow: hidden;
  margin-bottom: 18rpx;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.history-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 18rpx 4rpx 14rpx;
  background: transparent;
  border-bottom: 1rpx solid #e4ded3;
  text-align: left;
  line-height: 1.4;
}

.history-date > view {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.history-date-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 29rpx;
  font-weight: 700;
}

.history-progress {
  margin-top: 6rpx;
  color: #8c8f89;
  font-size: 21rpx;
}

.history-arrow {
  color: #92958f;
  flex: none;
  font-size: 38rpx;
}

.history-tasks {
  padding: 6rpx 4rpx 10rpx;
}

.history-task {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  color: #4d514c;
  font-size: 26rpx;
  line-height: 1.45;
}

.history-task.is-done {
  color: #999b96;
  text-decoration: line-through;
}

.history-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin: 14rpx 16rpx 0 0;
  border: 2rpx solid #86968e;
  border-radius: 50%;
}

.history-dot.is-complete {
  background: #3c765d;
  border-color: #3c765d;
}

.history-empty {
  margin-top: 56rpx;
}

@media (max-width: 350px) {
  .page-title {
    font-size: 54rpx;
  }

  .summary {
    font-size: 21rpx;
  }
}
