.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: content-box;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(251, 250, 246, 0.97);
  border-top: 1rpx solid rgba(215, 211, 200, 0.86);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #96958d;
}

.tab-item.is-active {
  color: #3c765d;
}

.tab-icon {
  position: relative;
  width: 44rpx;
  height: 40rpx;
  margin-bottom: 5rpx;
}

.tab-label {
  font-size: 20rpx;
  line-height: 1;
}

.home-roof {
  position: absolute;
  top: 3rpx;
  left: 7rpx;
  width: 25rpx;
  height: 25rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.home-body {
  position: absolute;
  right: 7rpx;
  bottom: 2rpx;
  left: 7rpx;
  box-sizing: border-box;
  height: 25rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 2rpx;
}

.home-door {
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  width: 8rpx;
  height: 13rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  transform: translateX(-50%);
}

.history-face {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-left-color: transparent;
  border-radius: 50%;
}

.history-face::before {
  position: absolute;
  top: -5rpx;
  left: -7rpx;
  width: 12rpx;
  height: 12rpx;
  content: '';
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
}

.history-hand {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 11rpx;
  height: 3rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform-origin: left center;
}

.history-hand.hour {
  width: 9rpx;
  transform: rotate(-90deg);
}

.history-hand.minute {
  transform: rotate(28deg);
}

.slider-line {
  position: absolute;
  right: 2rpx;
  left: 2rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 4rpx;
}

.slider-line.line-one { top: 5rpx; }
.slider-line.line-two { top: 18rpx; }
.slider-line.line-three { top: 31rpx; }

.slider-knob {
  position: absolute;
  top: 50%;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  background: #fbfaf6;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translateY(-50%);
}

.line-one .slider-knob { left: 8rpx; }
.line-two .slider-knob { right: 7rpx; }
.line-three .slider-knob { left: 15rpx; }
