{
  "name": "daily-note",
  "version": "1.3.1",
  "description": "A calm, cross-platform desktop daily todo note.",
  "main": "main.js",
  "author": "Daily Note",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build:pwa": "node scripts/build-pwa.js",
    "pwa": "npm run build:pwa && node scripts/serve-pwa.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dailynote.desktop",
    "productName": "小笺",
    "icon": "src/icons/icon-512.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
